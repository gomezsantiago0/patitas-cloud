        <mxCell id="f5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;labelBackgroundColor=#ffffff;fontStyle=1;fontSize=12;" edge="1" parent="1" source="appi" target="logs">
          <mxGeometry relative="1" as="geometry"/>
