<mxfile host="app.diagrams.net">
  <diagram id="red-seguridad" name="Red y seguridad">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Red y seguridad - Patitas Cloud (ambiente dev desplegado)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitulo" value="Las flechas numeradas son los flujos (ver leyenda). La zona gris punteada es solo diseño de producción y no está construida." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="42" width="800" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="zInternet" value="Internet (zona no confiable)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="250" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="cliente" value="Cliente de la veterinaria&#xa;Navegador web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="personal" value="Personal de la veterinaria&#xa;(hoy usa la misma página, sin inicio de sesión)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="leyenda" value="Flujos&#xa;1. Cliente al sitio, por HTTPS&#xa;2. Sitio a la API, mismo origen (/api)&#xa;3. API a Cosmos, con cadena de conexión&#xa;4. API a Application Insights (telemetría)&#xa;5. Application Insights a Log Analytics&#xa;6. Actions lee el token de GitHub Secrets&#xa;7. Actions despliega con el token (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="338" width="250" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="zGithub" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="250" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="secreto" value="GitHub Secrets&#xa;AZURE_STATIC_WEB_APPS_API_TOKEN_DEV&#xa;(token con alcance a un solo recurso)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="510" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="actions" value="GitHub Actions&#xa;permissions: contents: read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2f3e4e;strokeColor=#1f2a36;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="210" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="zAzure" value="Azure for Students (suscripción), grupo rg-patitas-dev" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#f0f6fc;strokeColor=#0078d4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="940" height="640" as="geometry"/>
        </mxCell>

        <mxCell id="zSwa" value="Static Web Apps (plan Free) - East US 2, HTTPS gestionado por la plataforma" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="400" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="sitio" value="Sitio estático&#xa;HTML, CSS y JS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="370" y="160" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API (Azure Functions)&#xa;Node.js 22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cabeceras" value="Cabeceras de seguridad (staticwebapp.config.json):&#xa;CSP restrictiva (solo mismo origen), nosniff,&#xa;X-Frame-Options DENY, Referrer-Policy no-referrer.&#xa;La API valida los datos y no devuelve nombre,&#xa;teléfono ni correo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="260" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="Configuración de la aplicación, inyectada por el Bicep (no está en el repo): cadena de Cosmos y de Application Insights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="365" width="360" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="zDatos" value="Datos - Mexico Central" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="110" width="440" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="cosmos" value="Cosmos DB for NoSQL (sin servidor)&#xa;base patitas, contenedor citas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="810" y="160" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="limiteCosmos" value="Limitación: acceso de red público habilitado, sin reglas de IP ni endpoint privado. Respaldo periódico cada 4 h, 7 días." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="150" width="185" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="zMon" value="Observabilidad" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="440" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="appi" value="Application Insights&#xa;alerta requests/failed &gt; 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="810" y="385" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="logs" value="Log Analytics&#xa;retención 30 días, tope 1 GB/día" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1030" y="385" width="180" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="zDiseno" value="Solo diseño de producción (no construido)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="790" y="500" width="440" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="kv" value="Key Vault&#xa;secretos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="810" y="550" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mi" value="Identidad administrada&#xa;de la API" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="945" y="550" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="Inicio de sesión&#xa;del personal" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1090" y="550" width="125" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="notaDiseno" value="La identidad administrada leería los secretos de Key Vault. Requiere Functions propias en plan Standard. Alternativa evaluada: OIDC en lugar del token." style="text;html=1;fontSize=10;fontColor=#666666;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="810" y="625" width="400" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;labelBackgroundColor=#ffffff;fontStyle=1;fontSize=12;strokeWidth=2;" edge="1" parent="1" source="cliente" target="sitio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;labelBackgroundColor=#ffffff;fontStyle=1;fontSize=12;" edge="1" parent="1" source="sitio" target="api">
