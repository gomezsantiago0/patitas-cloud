        <mxCell id="f3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;labelBackgroundColor=#ffffff;fontStyle=1;fontSize=12;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="cosmos">
          <mxGeometry relative="1" as="geometry"/>
